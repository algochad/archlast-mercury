# Paracord Docker overrides — OPTIONAL. Everything works with NO .env at all.
#
#   docker compose up -d          # zero config; secrets are auto-generated
#
# The server generates and persists a random JWT secret (and self-signed media
# certs) into the /data volume on first run, so there is nothing you must set
# before starting. Copy this file to .env only if you want one of the optional
# overrides below.
#
#   cp .env.example .env
#
# .env is git-ignored; only this template (.env.example) is tracked.

# Public URL used for CORS and invite links. Auto-detected when unset; set it
# for internet-facing deployments behind a reverse proxy.
# PARACORD_PUBLIC_URL=https://chat.example.com

# --- Built-in TLS (optional) -------------------------------------------------
# The container serves plain HTTP on 8090 by default and expects TLS to be
# terminated at a reverse proxy. To use Paracord's built-in HTTPS instead, set
# this true and mount certificates into /data/certs.
# PARACORD_TLS_ENABLED=true

# --- LiveKit fallback (optional) ---------------------------------------------
# Native QUIC/WebTransport media is the default and needs none of this. LiveKit
# is opt-in: start it with `docker compose --profile livekit up -d` and set
# PARACORD_VOICE_NATIVE_MEDIA=false on the paracord service to route through it.
# Both the paracord and livekit services read the secret below; a local dev
# default is used when it is unset. Set a strong random value before exposing
# LiveKit to a network (generate: openssl rand -hex 32).
# PARACORD_LIVEKIT_API_SECRET=

# --- Reverse proxy (Coolify / Traefik, nginx, Caddy) -------------------------
# Behind a reverse proxy, set all three. MERCURY_PUBLIC_URL is required for
# correct invite links and CORS. TRUST_PROXY + TRUSTED_PROXY_IPS make
# X-Forwarded-For trusted only from Traefik/nginx (see crates/paracord-util/src/client_ip.rs).
# Without them, all clients appear as 127.0.0.1 and rate-limit as one IP.
# (deprecated alias: PARACORD_* still works via server fallback.)
#   MERCURY_PUBLIC_URL=https://chat.example.com
#   MERCURY_TRUST_PROXY=true
#   MERCURY_TRUSTED_PROXY_IPS=172.18.0.0/16   # set to your Traefik/proxy CIDR — do not use "*"
#   MERCURY_COOKIE_SECURE=true
#   MERCURY_AUTO_PORT_FORWARD=false
#   MERCURY_TLS_ENABLED=false
# For Coolify Compose resource exposing via host port, also:
#   MERCURY_HOST_BIND=0.0.0.0

# --- PostgreSQL (optional) ---------------------------------------------------
# SQLite is the default (zero config) — `docker compose up -d` needs nothing here.
# For PostgreSQL via this compose file:
#   1. cp .env.example .env
#   2. Set POSTGRES_PASSWORD below (generate: openssl rand -hex 32)
#   3. Uncomment the three MERCURY_* lines
#   4. docker compose --profile postgres up -d
#
# The postgres service is profile-gated — it only starts with --profile postgres,
# so SQLite users are unaffected.
# For Coolify: prefer a managed Postgres resource (see docs/coolify.md) instead
# of --profile postgres on the Coolify host.
# (deprecated alias: PARACORD_* still works via server fallback.)
#   POSTGRES_PASSWORD=
#   MERCURY_DATABASE_ENGINE=postgres
#   MERCURY_DATABASE_URL=postgresql://mercury:${POSTGRES_PASSWORD}@postgres:5432/mercury
#   MERCURY_DATABASE_MAX_CONNECTIONS=50
